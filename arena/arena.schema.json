{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ququ-arena/arena.schema.json",
  "title": "AI斗兽场 蛐蛐罐（Arena Package v0.1）",
  "description": "一个蛐蛐罐 = 一个目录：arena.json（本文件约束）+ tasks.jsonl（每行一题）",
  "type": "object",
  "required": [
    "name",
    "title",
    "description",
    "judge"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "编辑器自引用：../arena.schema.json"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-一-鿿]*$",
      "description": "英文 id 或中文短横线 id，如 tongjia-pinyin"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "中文标题"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "测什么能力、为什么值得测"
    },
    "author": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "review": {
      "type": "object",
      "required": [
        "date"
      ],
      "additionalProperties": false,
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "blockedReason": {
          "type": "string",
          "minLength": 1
        },
        "excluded": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "canary": {
      "type": "string",
      "pattern": "^ququ-arena:",
      "description": "污染过滤标记（BIG-bench 式 canary），供下游从训练语料过滤本题库"
    },
    "judge": {
      "$ref": "#/definitions/judgeSpec",
      "description": "默认评分规则"
    },
    "taskPrefix": {
      "type": "string",
      "description": "统一题面前缀：开赛时拼到每题 input 前，共有框架（人格/规则）只写一次"
    },
    "conditionPrefix": {
      "type": "object",
      "description": "分维度题面前缀：condition → 前缀，拼接顺序 taskPrefix → conditionPrefix → input",
      "additionalProperties": {
        "type": "string"
      }
    },
    "conditions": {
      "type": "object",
      "description": "维度字典：condition 标签 → 中文说明",
      "additionalProperties": {
        "type": "string"
      }
    },
    "mode": {
      "type": "string",
      "enum": [
        "qa",
        "open",
        "multi_turn"
      ],
      "description": "赛道，旧题库缺省为短题竞速"
    }
  },
  "definitions": {
    "judgeSpec": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "exact"
            },
            "trimPunct": {
              "type": "boolean"
            },
            "ignoreCase": {
              "type": "boolean"
            },
            "lenient": {
              "type": "boolean",
              "description": "opt-in 宽松口径：额外接受「答案对、只是多说了话」的作答（如「戊是老实人」→「老实人」）。默认 false，既有 exact 语义不变。"
            },
            "alternatives": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "keywords"
          ],
          "properties": {
            "kind": {
              "const": "contains"
            },
            "keywords": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "pattern"
          ],
          "properties": {
            "kind": {
              "const": "regex"
            },
            "pattern": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "rubric"
          ],
          "properties": {
            "kind": {
              "const": "llm"
            },
            "rubric": {
              "type": "string",
              "minLength": 20,
              "description": "评分标准，越具体裁判间一致性越高"
            },
            "scale": {
              "type": "integer",
              "minimum": 2,
              "default": 10
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "judges"
          ],
          "description": "组合裁判·逻辑与：子裁判取最低分",
          "properties": {
            "kind": {
              "const": "all"
            },
            "judges": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/judgeSpec"
              },
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "judges"
          ],
          "description": "组合裁判·逻辑或：子裁判取最高分",
          "properties": {
            "kind": {
              "const": "any"
            },
            "judges": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/judgeSpec"
              },
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "judge"
          ],
          "description": "组合裁判·否定：1 − 子裁判分（配 0/1 规则子裁判用）",
          "properties": {
            "kind": {
              "const": "not"
            },
            "judge": {
              "$ref": "#/definitions/judgeSpec"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "dimensions"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "rubric"
            },
            "dimensions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "name",
                  "weight",
                  "criteria"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[\\w-]{1,64}$"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "weight": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 100
                  },
                  "criteria": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
